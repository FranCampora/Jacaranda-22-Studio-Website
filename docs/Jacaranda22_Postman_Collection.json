    {
      "name": "Reportes",
      "description": "Endpoints para la visualización de métricas financieras, estados y géneros del estudio.",
      "item": [
        {
          "name": "1. Reporte General (Ejecutivo)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reportes?tipo=general",
              "host": ["{{baseUrl}}"],
              "path": ["reportes"],
              "query": [
                {
                  "key": "tipo",
                  "value": "general"
                }
              ]
            },
            "description": "Retorna el consolidado general: métricas financieras, distribución por estados y distribución por género."
          },
          "response": []
        },
        {
          "name": "2. Reporte Financiero y Carga Horaria",
          "request": {
            "method": "GET",
            "header": [],
