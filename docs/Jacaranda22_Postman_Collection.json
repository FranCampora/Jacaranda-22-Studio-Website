{
  "info": {
    "_postman_id": "c8e2350a-f91c-4e89-a541-e9bb495a639b",
    "name": "Jacaranda 22 Studio - API RESTful",
    "description": "Colección completa de pruebas para la API RESTful de Jacarandá 22 Studio (Arquitectura Web). Incluye carpetas para Proyectos (CRUD y relación N:M), Integrantes (CRUD) y Reportes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Proyectos",
      "description": "Endpoints para la gestión de proyectos y asignación de integrantes.",
      "item": [
        {
          "name": "Listar todos los proyectos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/proyectos",
              "host": ["{{baseUrl}}"],
              "path": ["proyectos"]
            },
            "description": "Retorna la lista de todos los proyectos registrados."
          },
          "response": []
        },
        {
          "name": "Obtener proyecto por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/proyectos/1",
              "host": ["{{baseUrl}}"],
              "path": ["proyectos", "1"]
            },
            "description": "Retorna el proyecto con ID 1 incluyendo su listado de integrantes vinculados."
          },
          "response": []
        },
        {
          "name": "Crear nuevo proyecto",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Single Jacaranda Feat\",\n  \"tipo\": \"single\",\n  \"estado\": \"nuevo\",\n  \"fecha_inicio\": \"2026-03-01\",\n  \"fecha_fin_estimada\": \"2026-04-15\",\n  \"genero\": \"Trap / R&B\",\n  \"descripcion\": \"Producción completa y masterización\",\n  \"precio_por_hora\": 3500,\n  \"cantidad_horas\": 12\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/proyectos",
              "host": ["{{baseUrl}}"],
              "path": ["proyectos"]
            },
            "description": "Crea un nuevo proyecto en la base de datos."
          },
          "response": []
        },
        {
          "name": "Actualizar proyecto existente",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"grabacion\",\n  \"cantidad_horas\": 16\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/proyectos/1",
              "host": ["{{baseUrl}}"],
              "path": ["proyectos", "1"]
            },
            "description": "Actualiza parcialmente los datos de un proyecto existente."
          },
          "response": []
        },
        {
          "name": "Obtener integrantes de un proyecto",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/proyectos/1/integrantes",
              "host": ["{{baseUrl}}"],
              "path": ["proyectos", "1", "integrantes"]
            },
            "description": "Retorna los integrantes asignados al proyecto 1 junto con su rol_en_proyecto."
          },
          "response": []
        },
        {
          "name": "Asignar integrante al proyecto",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"integrante_id\": 3,\n  \"rol_en_proyecto\": \"Coros y arreglos vocales\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/proyectos/1/integrantes",
              "host": ["{{baseUrl}}"],
              "path": ["proyectos", "1", "integrantes"]
            },
            "description": "Vincula al integrante 3 al proyecto 1 especificando su rol."
          },
          "response": []
        },
        {
          "name": "Desvincular integrante del proyecto",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/proyectos/1/integrantes/3",
              "host": ["{{baseUrl}}"],
              "path": ["proyectos", "1", "integrantes", "3"]
            },
            "description": "Desvincula al integrante 3 del proyecto 1."
          },
          "response": []
        },
        {
          "name": "Eliminar proyecto",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/proyectos/6",
              "host": ["{{baseUrl}}"],
              "path": ["proyectos", "6"]
            },
            "description": "Elimina el proyecto con ID 6 (o el creado durante las pruebas)."
          },
          "response": []
        }
      ]
    },
