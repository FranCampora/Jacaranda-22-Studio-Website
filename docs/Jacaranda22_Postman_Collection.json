              "raw": "{{baseUrl}}/reportes?tipo=financiero",
              "host": ["{{baseUrl}}"],
              "path": ["reportes"],
              "query": [
                {
                  "key": "tipo",
                  "value": "financiero"
                }
              ]
            },
            "description": "Retorna totales de proyectos, horas facturadas, estimación económica y precio medio por hora."
